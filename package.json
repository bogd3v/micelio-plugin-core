{
  "name": "@micelio/strapi-plugin-core",
  "version": "0.1.0",
  "description": "Micelio's core as a Strapi 5 plugin: sites, blocks, the editorial workflow, hooks and the host check.",
  "type": "commonjs",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bogd3v/micelio-plugin-core.git"
  },
  "keywords": [
    "strapi",
    "strapi-plugin",
    "micelio"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "micelio": "0.6",
  "strapi": {
    "kind": "plugin",
    "name": "micelio",
    "displayName": "Micelio",
    "description": "Micelio's core: sites, blocks, the editorial workflow, hooks and the host check."
  },
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "bin": {
    "micelio": "bin/micelio.js"
  },
  "files": [
    "bin",
    "dist",
    "strapi-admin.js",
    "strapi-server.js",
    "THIRD-PARTY.md",
    "LICENSES"
  ],
  "scripts": {
    "dev": "strapi-plugin watch",
    "build": "strapi-plugin build",
    "typecheck": "tsc -p server/tsconfig.json --noEmit && tsc -p admin/tsconfig.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:licenses": "node scripts/check-licenses.mjs",
    "lint:standard": "micelio-lint-standard",
    "lint:reference": "node scripts/hooks-reference.mjs --check",
    "reference": "node scripts/hooks-reference.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "strapi-plugin verify",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run lint:licenses && npm run lint:standard && npm run lint:reference"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/strapi": "^5.59.0",
    "@strapi/utils": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@micelio/eslint-config": "^0.1.2",
    "@micelio/prettier-config": "^0.1.0",
    "@micelio/tsconfig": "^0.1.0",
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.59.0",
    "@strapi/typescript-utils": "^5.59.0",
    "@strapi/utils": "^5.59.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "better-sqlite3": "12.11.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "sanitize-html": "^2.18.1",
    "styled-components": "^6.6.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "prettier": "@micelio/prettier-config",
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
