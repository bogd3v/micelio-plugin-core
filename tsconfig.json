{
  // The block contract, the scripts, the tests and the configuration files. The plugin's own code
  // is checked by server/tsconfig.json and admin/tsconfig.json, which `strapi-plugin build` uses.
  "extends": "@micelio/tsconfig",
  "compilerOptions": {
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["contract", "scripts", "test", "vitest.config.mts"]
}
