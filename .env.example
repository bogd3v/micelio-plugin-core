# Names of the variables this project reads, with a safe example value. Copy to `.env` (never committed).
# Document each variable here and in docs/ when it is added.

# compose.dev.yml (npm run dev:docker, docs/operate/manual-testing.md). The script writes these to
# .env.docker (gitignored) with new throwaway secrets on the first run; they are listed so the names are
# known. Never reuse a real secret here.
# DATABASE_PASSWORD=       Password of the stack's PostgreSQL.
# APP_KEYS=                Four comma-separated keys for Strapi's sessions.
# API_TOKEN_SALT=          Strapi's salts and secrets.
# ADMIN_JWT_SECRET=
# TRANSFER_TOKEN_SALT=
# ENCRYPTION_KEY=
# JWT_SECRET=
# FRONTEND_API_TOKEN=      Access key of the read-only API token the seed creates for the frontend.
# PREVIEW_API_TOKEN=      Access key of the custom API token the seed creates to try the preview exchange by hand.
# Optional, set in the environment of the command, not in .env.docker:
# FRONTEND_IMAGE=ghcr.io/bogd3v/micelio:edge   The frontend image; a local build goes here.

# The plugin (docs/operate/about-page.md). Set in the environment of the CMS.
# MICELIO_UPDATE_CHECK=false   Turns off the daily read of the release feed; nothing else leaves the CMS for it. On by default.
# MICELIO_UPDATE_FEED=         The release feed to read instead of the core's GitHub releases, for a mirror or an offline network.
