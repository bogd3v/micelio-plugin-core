{
  "kind": "collectionType",
  "collectionName": "micelio_sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site",
    "description": "One site the CMS serves: its identity, its host names and the modules the frontend turns on"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    },
    "content-type-builder": {
      "visible": false
    },
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "string",
      "regex": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64,
      "required": true,
      "unique": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "hosts": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "isDefault": {
      "type": "boolean",
      "default": false,
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "editorialPolicy": {
      "type": "json",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "tagline": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "url": {
      "type": "string",
      "regex": "^https?://\\S+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultLocale": {
      "type": "enumeration",
      "enum": ["en", "es"],
      "default": "en",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "author": {
      "type": "component",
      "repeatable": false,
      "component": "micelio-site.author",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "defaultOgImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "socialLinks": {
      "type": "component",
      "repeatable": true,
      "component": "micelio-site.social-link",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "contactEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "privacyContactEmail": {
      "type": "email",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "securityContact": {
      "type": "string",
      "maxLength": 512,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "privacyJurisdiction": {
      "type": "enumeration",
      "enum": ["colombia"],
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "privacyUpdatedAt": {
      "type": "datetime",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "supportHandle": {
      "type": "string",
      "regex": "^[A-Za-z0-9_-]+$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "timezone": {
      "type": "string",
      "regex": "^[A-Za-z][A-Za-z0-9]*(?:[/_+-][A-Za-z0-9]+)*$",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "addressLocality": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "modules": {
      "type": "component",
      "repeatable": false,
      "component": "micelio-site.modules",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "theme": {
      "type": "component",
      "repeatable": false,
      "component": "micelio-site.theme",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    },
    "fediverse": {
      "type": "component",
      "repeatable": false,
      "component": "micelio-site.fediverse",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      }
    }
  }
}
