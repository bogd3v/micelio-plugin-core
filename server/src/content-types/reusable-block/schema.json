      "type": "string",
      "required": true,
      "maxLength": 80,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "blocks": {
      "type": "dynamiczone",
      "components": [],
      "required": true,
      "min": 1,
      "max": 1,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    }
  }
}
