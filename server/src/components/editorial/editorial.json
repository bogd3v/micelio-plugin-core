{
  "collectionName": "components_micelio_editorial_editorials",
  "info": {
    "displayName": "Editorial",
    "icon": "check",
    "description": "Where the entry is in the editorial workflow (ADR-0017, section 5). It changes only through a transition"
  },
  "options": {},
  "attributes": {
    "state": {
      "type": "enumeration",
      "enum": ["draft", "in_review", "scheduled", "published"],
      "default": "draft",
      "required": true
    },
    "publishAt": {
      "type": "datetime"
    },
    "reviewedBy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "admin::user"
    },
    "publishedBy": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "admin::user"
    }
  }
}
