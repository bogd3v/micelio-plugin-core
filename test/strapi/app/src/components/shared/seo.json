{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "The `seo` component of micelio-cms, with the limits it declares (60 and 160 characters; the plugin lifts them) and nothing required, so the preview suites that save a page without one still pass"
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "maxLength": 60
    },
    "metaDescription": {
      "type": "string",
      "maxLength": 160
    },
    "metaImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "keywords": { "type": "text" },
    "metaRobots": { "type": "string" },
    "structuredData": { "type": "json" },
    "canonicalURL": { "type": "string" }
  }
}
