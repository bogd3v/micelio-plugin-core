{
  "collectionName": "components_section_scenes",
  "info": {
    "displayName": "Scene",
    "icon": "globe",
    "description": "A 3D scene, a heavy island: a glTF model with a required poster (its static alternative) and alt text, as in micelio-cms; with the `tone` option (no default here) and the `group` key for the groups suite"
  },
  "options": {},
  "attributes": {
    "blockId": { "type": "string" },
    "eyebrow": { "type": "string" },
    "anchor": { "type": "string" },
    "variant": {
      "type": "enumeration",
      "enum": ["background", "inline"],
      "default": "background",
      "required": true
    },
    "tone": {
      "type": "enumeration",
      "enum": ["default", "raised", "accent"]
    },
    "model": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["files"],
      "required": true
    },
    "poster": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"],
      "required": true
    },
    "alt": {
      "type": "string",
      "required": true
    },
    "title": {
      "type": "string"
    },
    "text": {
      "type": "text"
    },
    "group": {
      "type": "component",
      "repeatable": false,
      "component": "section.group"
    }
  }
}
