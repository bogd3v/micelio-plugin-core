              },
              "required": ["label", "url"],
              "x-strapi": { "type": "component", "component": "section.link", "repeatable": false }
            },
            { "type": "null" }
          ]
        },
        "media": {
          "anyOf": [
            {
              "type": "object",
              "properties": { "url": { "type": "string" }, "mime": { "type": "string" } },
              "required": ["url", "mime"],
              "additionalProperties": {},
              "x-strapi": {
                "type": "media",
                "multiple": false,
                "allowedTypes": ["images", "videos"]
              }
            },
            { "type": "null" }
          ]
        },
        "variant": {
          "type": "string",
          "enum": ["centered", "split", "full-bleed"],
          "x-strapi": { "type": "enumeration" },
          "default": "centered"
        },
        "layout": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["centered", "split", "stacked"],
              "x-strapi": { "type": "enumeration" },
              "default": "centered"
            },
            { "type": "null" }
          ]
        },
        "tone": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["default", "raised", "accent"],
              "x-strapi": { "type": "enumeration" },
              "default": "default"
            },
            { "type": "null" }
          ]
        },
        "height": {
          "anyOf": [
            {
              "type": "string",
              "enum": ["s", "m", "l", "full"],
              "x-strapi": { "type": "enumeration" },
              "default": "m"
            },
            { "type": "null" }
          ]
        }
      },
      "required": ["title", "variant"],
      "x-strapi": { "type": "component", "component": "section.hero", "repeatable": false }
    },
    "feature-grid": {
