        "primaryLink": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": { "type": "string", "x-strapi": { "type": "string" } },
                "url": {
                  "type": "string",
                  "pattern": "^(https?:\\/\\/\\S+|mailto:\\S+|\\/\\S*)$",
                  "x-strapi": { "type": "string" }
                }
              },
              "required": ["label", "url"],
              "x-strapi": { "type": "component", "component": "section.link", "repeatable": false }
            },
            { "type": "null" }
          ]
        },
        "secondaryLink": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "label": { "type": "string", "x-strapi": { "type": "string" } },
