{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    { "$ref": "#/$defs/ready" },
    { "$ref": "#/$defs/load-draft" },
    { "$ref": "#/$defs/micelio:select" },
    { "$ref": "#/$defs/micelio:hover" },
    { "$ref": "#/$defs/micelio:insertGap" },
    { "$ref": "#/$defs/micelio:patch" },
    { "$ref": "#/$defs/micelio:blocks" },
    { "$ref": "#/$defs/micelio:selected" },
    { "$ref": "#/$defs/micelio:hovered" }
  ],
  "$defs": {
    "ready": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "ready" },
        "payload": {
          "type": "object",
          "properties": {
            "v": {
              "minItems": 1,
              "type": "array",
              "items": { "type": "integer", "exclusiveMinimum": 0, "maximum": 9007199254740991 }
            },
            "documentId": { "type": "string", "minLength": 1 },
            "locale": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
            "version": { "type": "string", "minLength": 1 }
          },
          "required": ["v", "documentId", "locale", "version"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "ready",
      "description": "Frame → admin: the frame has loaded a draft."
    },
    "load-draft": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "load-draft" },
        "payload": {
          "type": "object",
          "properties": {
            "documentId": { "type": "string", "minLength": 1 },
            "locale": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] }
          },
          "required": ["documentId", "locale"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "load-draft",
      "description": "Admin → frame: reload the draft after a save."
    },
    "micelio:select": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:select" },
        "payload": {
          "type": "object",
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zone": { "type": "string", "const": "sections" },
                    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "block": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  },
                  "required": ["zone", "index", "block", "version"]
                },
                { "type": "null" }
              ]
            },
            "item": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
              ]
            },
            "reveal": { "type": "boolean" }
          },
          "required": ["address"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:select",
      "description": "Admin → frame: outline a block or an item."
    },
    "micelio:hover": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:hover" },
        "payload": {
          "type": "object",
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zone": { "type": "string", "const": "sections" },
                    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "block": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  },
                  "required": ["zone", "index", "block", "version"]
                },
                { "type": "null" }
              ]
            },
            "item": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
              ]
            }
          },
          "required": ["address"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:hover",
      "description": "Admin → frame: the block the list points at."
    },
    "micelio:insertGap": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:insertGap" },
        "payload": {
          "type": "object",
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "zone": { "type": "string", "const": "sections" },
            "after": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
              ]
            },
            "height": { "type": "number", "minimum": 0, "maximum": 2000 }
          },
          "required": ["version", "zone", "after", "height"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:insertGap",
      "description": "Admin → frame: open a gap after a block."
    },
    "micelio:patch": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:patch" },
        "payload": {
          "type": "object",
          "properties": {
            "address": {
              "type": "object",
              "properties": {
                "zone": { "type": "string", "const": "sections" },
                "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "block": { "type": "string", "minLength": 1 },
                "version": { "type": "string", "minLength": 1 }
              },
              "required": ["zone", "index", "block", "version"]
            },
            "content": {
              "type": "object",
              "propertyNames": { "type": "string" },
              "additionalProperties": { "type": ["string", "null"] }
            },
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                  "content": {
                    "type": "object",
                    "propertyNames": { "type": "string" },
                    "additionalProperties": { "type": ["string", "null"] }
                  }
                },
                "required": ["index", "content"]
              }
            }
          },
          "required": ["address", "content", "items"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:patch",
      "description": "Admin → frame: new text for a block."
    },
    "micelio:blocks": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:blocks" },
        "payload": {
          "type": "object",
          "properties": {
            "version": { "type": "string", "minLength": 1 },
            "scroll": {
              "type": "object",
              "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
              "required": ["x", "y"]
            },
            "viewport": {
              "type": "object",
              "properties": { "width": { "type": "number" }, "height": { "type": "number" } },
              "required": ["width", "height"]
            },
            "blocks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "address": {
                    "type": "object",
                    "properties": {
                      "zone": { "type": "string", "const": "sections" },
                      "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                      "block": { "type": "string", "minLength": 1 },
                      "version": { "type": "string", "minLength": 1 }
                    },
                    "required": ["zone", "index", "block", "version"]
                  },
                  "box": {
                    "type": "object",
                    "properties": {
                      "x": { "type": "number" },
                      "y": { "type": "number" },
                      "width": { "type": "number" },
                      "height": { "type": "number" }
                    },
                    "required": ["x", "y", "width", "height"]
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                        "box": {
                          "type": "object",
                          "properties": {
                            "x": { "type": "number" },
                            "y": { "type": "number" },
                            "width": { "type": "number" },
                            "height": { "type": "number" }
                          },
                          "required": ["x", "y", "width", "height"]
                        }
                      },
                      "required": ["index", "box"]
                    }
                  }
                },
                "required": ["address", "box", "items"]
              }
            }
          },
          "required": ["version", "scroll", "viewport", "blocks"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:blocks",
      "description": "Frame → admin: the boxes of the blocks."
    },
    "micelio:selected": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:selected" },
        "payload": {
          "type": "object",
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zone": { "type": "string", "const": "sections" },
                    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "block": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  },
                  "required": ["zone", "index", "block", "version"]
                },
                { "type": "null" }
              ]
            },
            "item": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
              ]
            },
            "box": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  },
                  "required": ["x", "y", "width", "height"]
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["address", "item", "box"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:selected",
      "description": "Frame → admin: the selected block."
    },
    "micelio:hovered": {
      "type": "object",
      "properties": {
        "v": { "type": "number", "const": 1 },
        "type": { "type": "string", "const": "micelio:hovered" },
        "payload": {
          "type": "object",
          "properties": {
            "address": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "zone": { "type": "string", "const": "sections" },
                    "index": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                    "block": { "type": "string", "minLength": 1 },
                    "version": { "type": "string", "minLength": 1 }
                  },
                  "required": ["zone", "index", "block", "version"]
                },
                { "type": "null" }
              ]
            },
            "item": {
              "anyOf": [
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                { "type": "null" }
              ]
            },
            "box": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "x": { "type": "number" },
                    "y": { "type": "number" },
                    "width": { "type": "number" },
                    "height": { "type": "number" }
                  },
                  "required": ["x", "y", "width", "height"]
                },
                { "type": "null" }
              ]
            }
          },
          "required": ["address", "item", "box"]
        }
      },
      "required": ["v", "type", "payload"],
      "title": "micelio:hovered",
      "description": "Frame → admin: the hovered block."
    }
  },
  "title": "Micelio preview messages",
  "description": "The messages between the admin and the preview frame, in the envelope { v, type, payload }. Generated from contract/preview.ts of @micelio/strapi-plugin-core (ADR-0019); do not edit."
}
